<template>
	<view class="container">
		<view class="search-box">
			<input class="search-input" type="text" v-model="searchValue" placeholder="请输入直播房间号" @confirm="watchLive"/>
		</view>
		
		<!-- 观看直播按钮 -->
		<view class="watch-button-container">
			<button class="watch-button" type="primary" @click="watchLive"><text class="button-text">观看直播</text></button>
		</view>
	</view>
</template>

<script>
	export default {
		data() {
			return {
				searchValue: '',
			}
		},
		methods: {
			clear() {
				this.searchValue = ''
			},
			watchLive() {
				// 跳转到直播详情页，并将房间号传递过去
				if (this.searchValue) {
					uni.navigateTo({
						url: `/pages/live/detail/index?roomId=${this.searchValue}`
					});
				} else {
					uni.showToast({
						title: '请输入房间号',
						icon: 'none'
					});
				}
			}
		}
	}
</script>

<style>
	/* page 标签是页面根节点 */
	page {
		flex: 1;
	}

	.container {
		flex: 1;
		background-color: #f5f5f5;
	}
	
	.search-box {
		padding: 20rpx;
		background-color: #ffffff;
		/* 根据 uni-search-bar 样式进行调整 */
		flex-direction: row;
		align-items: center;
	}

	.search-input {
		flex: 1;
		height: 70rpx; /* 调整高度 */
		line-height: 70rpx; /* 调整行高 */
		padding: 0 20rpx; /* 调整内边距 */
		background-color: #f5f5f5; /* 调整背景色 */
		border-radius: 35rpx; /* 半高圆角 */
		font-size: 28rpx; /* 调整字体大小 */
		margin-right: 20rpx; /* 调整右侧间距 */
	}
	
	.watch-button-container {
		margin-top: 40rpx;
		padding: 0 20rpx; /* 提供左右间距 */
	}

	.watch-button {
		width: 100%; /* 占满父容器宽度 */
		height: 100rpx; /* 调整高度 */
		line-height: 100rpx; /* 调整行高 */
		background-color: #007aff; /* 模拟 primary 颜色 */
		/* color: #ffffff; */ /* 文字颜色由内部 text 控制 */
		border-radius: 50rpx; /* 半高圆角 */
		text-align: center; /* 居中文本 */
		/* font-size: 32rpx; */ /* 字体大小由内部 text 控制 */
		margin-bottom: 30rpx; /* 添加底部间距，模拟 index 页面按钮组效果 */
	}

	.button-text {
		font-size: 32rpx;
		color: #ffffff;
	}
</style> 