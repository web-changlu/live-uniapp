	width: 100%;
	background: linear-gradient(180deg,rgba(0,0,0,0.00),rgba(0,0,0,0.55) 90%);
	padding: 18rpx 16rpx;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
