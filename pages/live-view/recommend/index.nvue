<template>
	<view class="container">
		<view class="header">
			<text class="title">推荐直播间</text>
		</view>
		<scroll-view class="room-list" scroll-y="true" :show-scrollbar="false" @scrolltolower="loadMore">
			<view class="grid">
				<view class="card" v-for="(item, index) in recommendList" :key="index" @click="enterRoom(item)">
					<view class="card-img-wrap">
						<image class="card-img" src="/static/recommend-title.png" mode="aspectFill" alt="直播间" />
						<view class="card-info-overlay">
							<view class="info-top">
								<view class="city-badge">
									<text class="city-icon">📍</text>
									<text class="city">{{item.city}}</text>
								</view>
							</view>
							<view class="info-bottom">
								<view class="info-left">
									<text class="nickname">{{item.nickname}}</text>
									<text class="level-badge">Lv.{{item.level}}</text>
									<text class="tag-badge">{{item.tag}}</text>
								</view>
								<view class="info-right">
									<text class="hot-icon">🔥</text>
									<text class="hot">{{item.hot}}</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>
			<view v-if="loading" class="loading">加载中...</view>
			<view v-if="!hasMore && recommendList.length" class="no-more">没有更多了</view>
		</scroll-view>
	</view>
</template>

<script>
const cityList = ['北京', '上海', '广州', '深圳', '杭州', '成都', '重庆', '苏州', '武汉', '西安'];
const tagList = ['新人', '热舞', '才艺', 'PK', '热门'];
function mockData(start, count) {
	const data = [];
	for (let i = start; i < start + count; i++) {
		data.push({
			nickname: `主播${i+1}`,
			city: cityList[i % cityList.length],
			viewerCount: Math.floor(Math.random()*10000),
			level: Math.floor(Math.random()*20)+1,
			tag: tagList[i % tagList.length],
			hot: Math.floor(Math.random()*10000)
		});
	}
	return data;
}
export default {
	data() {
		return {
			recommendList: [],
			page: 0,
			pageSize: 20,
			total: 100,
			hasMore: true,
			loading: false
		}
	},
	onLoad() {
		this.getRecommendList();
	},
	methods: {
		getRecommendList() {
			if (!this.hasMore || this.loading) return;
			this.loading = true;
			setTimeout(() => {
				const start = this.page * this.pageSize;
				const count = Math.min(this.pageSize, this.total - start);
				if (count <= 0) {
					this.hasMore = false;
					this.loading = false;
					return;
				}
				const newData = mockData(start, count);
				this.recommendList = this.recommendList.concat(newData);
				this.page++;
				this.hasMore = this.recommendList.length < this.total;
				this.loading = false;
			}, 500);
		},
		loadMore() {
			this.getRecommendList();
		},
		enterRoom(item) {
			console.log('进入直播间：', item)
		}
	}
}
</script>

