<template>
  <view class="video-controls">
    <view class="control-button" @click="toggleVideo">
      <text class="control-icon">{{ localStream.videoEnabled ? '📹' : '🚫' }}</text>
      <text class="control-text">{{ localStream.videoEnabled ? '关闭摄像头' : '开启摄像头' }}</text>
    </view>
    <view class="control-button" @click="toggleAudio">
      <text class="control-icon">{{ localStream.audioEnabled ? '🎤' : '🔇' }}</text>
      <text class="control-text">{{ localStream.audioEnabled ? '关闭麦克风' : '开启麦克风' }}</text>
    </view>
    <view class="control-button" @click="switchCamera">
      <text class="control-icon">🔄</text>
      <text class="control-text">切换摄像头</text>
    </view>
    <view class="control-button" @click="showBeauty">
      <text class="control-icon">✨</text>
      <text class="control-text">美颜</text>
    </view>
  </view>
</template>

<script setup>
defineProps({
  localStream: {
    type: Object,
    default: () => ({
      videoEnabled: false,
      audioEnabled: false
    })
  }
});

const emit = defineEmits(['toggle-video', 'toggle-audio', 'switch-camera', 'show-beauty']);

const toggleVideo = () => {
  emit('toggle-video');
};

const toggleAudio = () => {
  emit('toggle-audio');
};

const switchCamera = () => {
  emit('switch-camera');
};

const showBeauty = () => {
  emit('show-beauty');
};
</script>

<style>
/* 视频控制按钮 */
.video-controls {
  position: absolute;
  top: 120rpx;
  left: 30rpx;
  right: 30rpx;
  flex-direction: row;
  justify-content: space-around;
  z-index: 1;
}

/* 控制按钮 */
.control-button {
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 10rpx;
  padding: 10rpx 20rpx;
  flex-direction: column;
  align-items: center;
}

/* 控制图标 */
.control-icon {
  font-size: 40rpx;
  margin-bottom: 5rpx;
}

/* 控制文本 */
.control-text {
  color: #ffffff;
  font-size: 24rpx;
}
</style>