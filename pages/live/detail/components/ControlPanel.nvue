<template>
  <view class="video-controls">
    <!-- 视频控制按钮 -->
    <view class="control-row">
      <view v-if="isAnchor" class="control-button" :class="{ 'active': !localStream.videoEnabled }" @click="toggleVideo">
        <text class="control-icon">{{ localStream.videoEnabled ? '📹' : '🚫' }}</text>
      </view>
      <view v-if="isAnchor" class="control-button" :class="{ 'active': !localStream.audioEnabled }" @click="toggleAudio">
        <text class="control-icon">{{ localStream.audioEnabled ? '🎤' : '🔇' }}</text>
      </view>
      <view v-if="isAnchor" class="control-button" @click="switchCamera">
        <text class="control-icon">🔄</text>
      </view>
      <view v-if="isAnchor" class="control-button" @click="showBeauty">
        <text class="control-icon">✨</text>
      </view>
      <view class="interaction-button" @click="handleLike">
        <text class="interaction-icon interaction-count">👍</text>
        <text class="interaction-count">{{ likeCount }}</text>
      </view>
      <view class="interaction-button" @click="handleShare">
        <text class="interaction-icon">📤</text>
      </view>
      <view class="interaction-button" @click="handleGift">
        <text class="interaction-icon">🎁</text>
      </view>
    </view>
  </view>
</template>

<script setup>
defineProps({
  isAnchor: {
    type: Boolean,
    default: false
  },
  localStream: {
    type: Object,
    default: () => ({
      videoEnabled: false,
      audioEnabled: false
    })
  },
  likeCount: {
    type: Number,
    default: 0
  }
});

const emit = defineEmits([
  'toggle-video',
  'toggle-audio',
  'switch-camera',
  'show-beauty',
  'like',
  'share',
  'gift'
]);

const toggleVideo = () => {
  emit('toggle-video');
};

const toggleAudio = () => {
  emit('toggle-audio');
};

const switchCamera = () => {
  emit('switch-camera');
};

const showBeauty = () => {
  emit('show-beauty');
};

const handleLike = () => {
  emit('like');
};

const handleShare = () => {
  emit('share');
};

const handleGift = () => {
  emit('gift');
};
</script>

<style>
/* 视频控制按钮容器 */
.video-controls {
  flex-direction: column;
  border-bottom-width: 1rpx;
  border-bottom-color: #e9eef7;
}

/* 控制按钮行 */
.control-row {
  flex-direction: row;
  justify-content: space-around;
  margin-bottom: 30rpx;
}

/* 控制按钮 - 新拟态风格 */
.control-button {
  width: 50rpx;
  height: 50rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 12rpx;
  justify-content: center;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.control-button.active {
  background-color: rgba(233, 238, 247, 0.9);
  box-shadow: inset 2rpx 2rpx 4rpx rgba(209, 217, 230, 0.5), inset -2rpx -2rpx 4rpx rgba(255, 255, 255, 0.5);
}

/* 控制图标 */
.control-icon {
  font-size: 20rpx;
  color: #4a5568;
}

/* 互动按钮 */
.interaction-button {
  width: 50rpx;
  height: 50rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
  justify-content: center;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  flex-direction: column;
}

/* 互动图标 */
.interaction-icon {
  font-size: 24rpx;
  color: #4a5568;
  margin-bottom: 4rpx;
}

/* 互动文本 */
.interaction-text {
  font-size: 18rpx;
  color: #6b7a90;
}

/* 互动计数 */
.interaction-count {
  font-size: 18rpx;
  color: #007aff;
  font-weight: bold;
}

/* #ifdef APP-NVUE */
/* 为NVUE平台添加特定样式 - 简化版新拟态 */
.control-button {
  background-color: rgba(255, 255, 255, 0.9);
  border-width: 1rpx;
  border-color: rgba(255, 255, 255, 0.3);
  border-style: solid;
}

.control-button.active {
  background-color: rgba(233, 238, 247, 0.9);
  border-color: rgba(209, 217, 230, 0.5);
}

.interaction-button {
  background-color: rgba(255, 255, 255, 0.9);
  border-width: 1rpx;
  border-color: rgba(255, 255, 255, 0.3);
  border-style: solid;
}

.control-button:active, .interaction-button:active {
  transform: scale(0.95);
  opacity: 0.8;
}
/* #endif */

/* #ifdef APP-PLUS */
/* 为APP-PLUS平台添加完整的新拟态效果 */
.control-button {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.control-button.active {
  box-shadow: inset 2rpx 2rpx 4rpx rgba(209, 217, 230, 0.5), inset -2rpx -2rpx 4rpx rgba(255, 255, 255, 0.5);
}

.interaction-button {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.control-button:hover {
  transform: translateY(-1rpx);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
}

.control-button:active {
  transform: translateY(0.5rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.interaction-button:hover {
  transform: translateY(-1rpx);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
}

.interaction-button:active {
  transform: translateY(0.5rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}
/* #endif */
</style>