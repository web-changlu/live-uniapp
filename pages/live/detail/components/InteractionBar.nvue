<template>
  <view class="action-container">
    <view class="action-buttons">
      <view class="action-button" @click="handleLike">
        <view class="action-icon-wrapper like">
          <text class="action-icon">👍</text>
          <view class="ripple-effect"></view>
        </view>
        <text class="action-text">{{ likeCount }}</text>
      </view>
      <view class="action-button" @click="handleShare">
        <view class="action-icon-wrapper share">
          <text class="action-icon">📤</text>
        </view>
        <text class="action-text">分享</text>
      </view>
      <view class="action-button" @click="handleGift">
        <view class="action-icon-wrapper gift">
          <text class="action-icon">🎁</text>
        </view>
        <text class="action-text">礼物</text>
      </view>
    </view>

    <view class="control-buttons">
      <view v-if="isAnchor" class="end-live" @click="handleEndLive">
        <view class="button-content">
          <text class="control-icon">🔴</text>
          <text class="control-text">结束直播</text>
        </view>
      </view>
      <view v-else class="leave-room" @click="handleLeaveRoom">
        <view class="button-content">
          <text class="control-icon">👋</text>
          <text class="control-text">离开直播间</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup>
defineProps({
  isAnchor: {
    type: Boolean,
    default: false
  },
  likeCount: {
    type: Number,
    default: 0
  }
});

const emit = defineEmits(['like', 'share', 'gift', 'end-live', 'leave-room']);

const handleLike = () => {
  emit('like');
};

const handleShare = () => {
  emit('share');
};

const handleGift = () => {
  emit('gift');
};

const handleEndLive = () => {
  emit('end-live');
};

const handleLeaveRoom = () => {
  emit('leave-room');
};
</script>

<style>
