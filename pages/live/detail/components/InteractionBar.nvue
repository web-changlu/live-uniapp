  border-radius: 16rpx;
  justify-content: center;
  align-items: center;
  margin-bottom: 10rpx;
  background: #ffffff;
  border: 1rpx solid #e9eef7;
  box-shadow: 4rpx 4rpx 8rpx #e9eef7, -4rpx -4rpx 8rpx #ffffff;
}

/* 不同类型的图标背景 */
.like {
  background: #ffffff;
}

.share {
  background: #ffffff;
}

