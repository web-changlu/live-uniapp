.action-icon {
  font-size: 28rpx;
  color: #4a5568;
}

/* 操作文本 */
.action-text {
  color: #6b7a90;
  font-size: 20rpx;
  font-weight: 500;
  text-shadow: 0 1rpx 2rpx #f0f0f3;
}

/* 控制按钮组 */
.control-buttons {
  flex-direction: row;
  justify-content: center;
  margin-top: 20rpx;
}

/* 按钮内容 */
.button-content {
  flex-direction: row;
  align-items: center;
}

.control-icon {
  font-size: 22rpx;
  margin-right: 8rpx;
  color: #4a5568;
}

/* 结束直播按钮 */
.end-live {
  background: linear-gradient(135deg, #ff3b30 0%, #ff9500 100%);
  border-radius: 20rpx;
  padding: 12rpx 32rpx;
  border: 1rpx solid #ffb199;
  color: #fff;
  box-shadow: 4rpx 4rpx 12rpx #ffe0d3, -4rpx -4rpx 12rpx #fff0e0;
}

/* 离开房间按钮 */
.leave-room {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 12rpx 32rpx;
  border: 1rpx solid #e9eef7;
  color: #4a5568;
  box-shadow: 4rpx 4rpx 12rpx #e9eef7, -4rpx -4rpx 12rpx #ffffff;
}

/* 控制文本 */
.control-text {
  color: inherit;
  font-size: 22rpx;
  font-weight: 500;
  text-shadow: 0 1rpx 2rpx #f0f0f3;
}

/* #ifdef APP-NVUE */
.action-container, .action-icon-wrapper, .leave-room {
  background-color: #f6f8fb;
  border-color: #e9eef7;
}
.end-live {
  background-color: #ffb199;
  border-color: #ffb199;
}
