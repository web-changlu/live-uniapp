  box-shadow: 4rpx 4rpx 12rpx #ffe0d3, -4rpx -4rpx 12rpx #fff0e0;
}

/* 离开房间按钮 */
.leave-room {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 12rpx 32rpx;
  border: 1rpx solid #e9eef7;
